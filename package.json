{
  "name": "vite-pug-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky",
    "images": "node scripts/optimize-images.js"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ],
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "sass": "^1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  }
}
