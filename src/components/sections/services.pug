section#services.services
  .container.services__container
    .services.cta-banner
      h2.cta-banner__title Would you love to work with us?
      +btn('Get in touch', '#contact').btn

    .services__header
      h2.section-title What do we do
      p.services__desc We are a small team of designers and creators, you need us to help them build products and grow office.

    .services__grid
      article.service-card
        .service-card__icon-wrap
          svg(
            viewBox='0 0 64 64',
            aria-hidden='true',
            width='32',
            height='32',
            fill='none',
            stroke='currentColor',
            stroke-width='2'
          )
            path(d='M15 45 45 15l5 5-30 30-8 3 3-8Z')
            path(d='m37 23 5 5M12 12h14M12 20h8M42 48h12')
        h3.service-card__title Web design
        p.service-card__text Transforming idea and a robust interface into a sleek product in every screen.

      article.service-card
        .service-card__icon-wrap
          svg(
            viewBox='0 0 64 64',
            aria-hidden='true',
            width='32',
            height='32',
            fill='none',
            stroke='currentColor',
            stroke-width='2'
          )
            rect(x='14', y='16', width='36', height='32', rx='4')
            path(d='M24 28h16M24 36h10')
        h3.service-card__title Motion video
        p.service-card__text Explaners, logo animations and social clips that bring brands to life.

      article.service-card
        .service-card__icon-wrap
          svg(
            viewBox='0 0 64 64',
            aria-hidden='true',
            width='32',
            height='32',
            fill='none',
            stroke='currentColor',
            stroke-width='2'
          )
            path(d='M16 20h32v24H16z')
            path(d='M22 14h20v6H22zM22 44h20v6H22z')
        h3.service-card__title Print design
        p.service-card__text Posters, packaging and stationery prepared to be printed right.

      article.service-card
        .service-card__icon-wrap
          svg(
            viewBox='0 0 64 64',
            aria-hidden='true',
            width='32',
            height='32',
            fill='none',
            stroke='currentColor',
            stroke-width='2'
          )
            circle(cx='32', cy='32', r='16')
            path(d='M32 22v20M22 32h20')
        h3.service-card__title Illustration
        p.service-card__text Custom illustrations and icons that capture the brand's story.
