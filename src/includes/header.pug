include ../data/nav.pug

header.header
  .container.header__container
    a.logo(href="/")
      span.logo__icon K
      | eepsake
    
    nav.nav
      ul.nav__list
        each item in navItems
          li.nav__item
            a.nav__link(href=item.link class={'nav__link--active': item.active})= item.title
    
    .header__actions
      +btn('', '#')(class="btn-favourites" aria-label="Favourites")
        +icon('heart')
       
      button.burger(aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu")
        span.burger__line
        span.burger__line
        span.burger__line